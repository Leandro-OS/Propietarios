generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Comunidad {
  id                 Int      @id @default(autoincrement())
  via                String
  direccion          String
  numero             String
  codigoPostal       String
  urbanizacion       String?
  poblacion          String
  numPisos           Int
  numViviendas       Int
  numLocales         Int
  numSotanos         Int
  numParkings        Int
  numTrasteros       Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  numActualizaciones Int      @default(1)
  propietarios       Propietario[]
}

model Propietario {
  id                 Int      @id @default(autoincrement())
  nombre             String
  apellido1          String
  apellido2          String?
  tipoPropiedad      String
  numPropiedad       Int?
  pisoPropiedad      Int?
  tipo               String
  residente          String?
  tieneTrastero      Boolean  @default(false)
  numTrastero        Int?
  lugarTrastero      Int?
  tieneParking       Boolean  @default(false)
  numParking         Int?
  lugarParking       Int?
  comunidadId        Int
  comunidad          Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  numActualizaciones Int      @default(1)
  descripcionPropiedad String?
}

model ComunidadHistorico {
  id                 Int      @id @default(autoincrement())
  via                String
  direccion          String
  numero             String
  codigoPostal       String
  urbanizacion       String?
  poblacion          String
  numPisos           Int
  numViviendas       Int
  numLocales         Int
  numSotanos         Int
  numParkings        Int
  numTrasteros       Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  fechaSupresion     DateTime
  motivo             String?
  propietarios       PropietarioHistorico[]
}

model PropietarioHistorico {
  id                 Int      @id @default(autoincrement())
  nombre             String
  apellido1          String
  apellido2          String?
  tipoPropiedad      String
  numPropiedad       Int?
  pisoPropiedad      Int?
  tipo               String
  residente          String?
  tieneTrastero      Boolean
  numTrastero        Int?
  lugarTrastero      Int?
  tieneParking       Boolean
  numParking         Int?
  lugarParking       Int?
  comunidadId        Int
  comunidad          ComunidadHistorico @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  fechaSupresion     DateTime
  motivo             String?
  descripcionPropiedad String?
}
