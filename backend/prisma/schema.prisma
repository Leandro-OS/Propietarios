generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Comunidad {
  id                 Int      @id @default(autoincrement())
  via                String
  direccion          String
  numero             String
  codigoPostal       String
  urbanizacion       String?
  poblacion          String
  numPisos           Int
  numViviendas       Int
  numLocales         Int
  numSotanos         Int
  numParkings        Int
  numTrasteros       Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  numActualizaciones Int      @default(1)
  propietarios       Propietario[]
  incidenciasComunidad IncidenciaComunidadTitulo[]
}

model Propietario {
  id                   Int      @id @default(autoincrement())
  nombre               String
  apellido1            String
  apellido2            String?
  tipoPropiedad        String
  descripcionPropiedad String?
  numPropiedad         Int?
  pisoPropiedad        Int?
  tipo                 String
  residente            String?
  tieneTrastero        Boolean  @default(false)
  numTrastero          Int?
  lugarTrastero        Int?
  tieneParking         Boolean  @default(false)
  numParking           Int?
  lugarParking         Int?
  comunidadId          Int
  comunidad            Comunidad @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  numActualizaciones   Int      @default(1)
  incidenciasPropietario IncidenciaPropietarioTitulo[]
}

model ComunidadHistorico {
  id                 Int      @id @default(autoincrement())
  via                String
  direccion          String
  numero             String
  codigoPostal       String
  urbanizacion       String?
  poblacion          String
  numPisos           Int
  numViviendas       Int
  numLocales         Int
  numSotanos         Int
  numParkings        Int
  numTrasteros       Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  fechaSupresion     DateTime
  motivo             String?
  propietarios       PropietarioHistorico[]
}

model PropietarioHistorico {
  id                   Int      @id @default(autoincrement())
  nombre               String
  apellido1            String
  apellido2            String?
  tipoPropiedad        String
  descripcionPropiedad String?
  numPropiedad         Int?
  pisoPropiedad        Int?
  tipo                 String
  residente            String?
  tieneTrastero        Boolean
  numTrastero          Int?
  lugarTrastero        Int?
  tieneParking         Boolean
  numParking           Int?
  lugarParking         Int?
  comunidadId          Int
  comunidad            ComunidadHistorico @relation(fields: [comunidadId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  fechaSupresion       DateTime
  motivo               String?
}

model IncidenciaComunidadTitulo {
  idIncidencia        Int      @id @default(autoincrement())
  idCom              Int
  comunidad           Comunidad @relation(fields: [idCom], references: [id], onDelete: Cascade)
  tipoIncidencia      String
  subtipoIncidencia   String?
  descripcion         String
  estado              String
  descripcionEstado   String
  fechaCreacion       DateTime @default(now())
  fechaModificacion   DateTime?
  fechaCierre         DateTime?
  registros           IncidenciaComunidadRegistros[]
}

model IncidenciaPropietarioTitulo {
  idIncidencia        Int      @id @default(autoincrement())
  idPro              Int
  propietario         Propietario @relation(fields: [idPro], references: [id], onDelete: Cascade)
  tipoIncidencia      String
  subtipoIncidencia   String?
  descripcion         String
  estado              String
  descripcionEstado   String?
  fechaCreacion       DateTime @default(now())
  fechaModificacion   DateTime?
  fechaCierre         DateTime?
  registros           IncidenciaPropietarioRegistros[]
}

model IncidenciaComunidadRegistros {
  idIncComReg         Int      @id @default(autoincrement())
  idIncCom            Int
  incidenciaTitulo    IncidenciaComunidadTitulo @relation(fields: [idIncCom], references: [idIncidencia], onDelete: Cascade)
  tipoIncidencia      String
  subtipoIncidencia   String?
  descripcion         String
  estado              String
  descripcionEstado   String
  fechaCreacion       DateTime @default(now())
  fechaModificacion   DateTime?
}

model IncidenciaPropietarioRegistros {
  idIncProReg         Int      @id @default(autoincrement())
  idIncPro            Int
  incidenciaTitulo    IncidenciaPropietarioTitulo @relation(fields: [idIncPro], references: [idIncidencia], onDelete: Cascade)
  tipoIncidencia      String
  subtipoIncidencia   String?
  descripcion         String
  estado              String
  descripcionEstado   String?
  fechaCreacion       DateTime @default(now())
  fechaModificacion   DateTime?
}
